# Paid trust-tier gateway (Railway / self-host)
# Copy secrets into Railway dashboard or `railway variables set KEY=value`

MCK_TRANSPORT=http
MCK_SOURCE_PROFILE=trust
MCK_SKU=paid
MCK_LEGACY_TOOL_NAMES=true
MCK_API_KEYS=
MCK_AUDIT_LOG=true
# MCK_TENANT_ID=default-fallback-when-no-jwt
MCK_OAUTH_JWKS_URL=
MCK_OAUTH_ISSUER=
MCK_OAUTH_AUDIENCE=mcp-gateway
MCK_OAUTH_TENANT_CLAIM=sub
GITHUB_TOKEN=
BRAVE_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
MCK_WEB_READER_ALLOWLIST=https://docs.github.com,https://en.wikipedia.org
