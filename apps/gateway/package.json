{
  "name": "@mck/gateway",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "mck-gateway": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@mck/core": "workspace:*",
    "@mck/server": "workspace:*",
    "@mck/source-fixture": "workspace:*",
    "@mck/source-khanoumi": "workspace:*",
    "@mck/source-torob": "workspace:*",
    "@mck/source-woocommerce": "workspace:*",
    "@mck/source-wikipedia": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@mck/testing": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tsup": "^8.4.0",
    "undici": "^7.10.0",
    "vitest": "^3.2.4"
  }
}
