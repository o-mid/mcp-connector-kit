    "@mck/source-hn": "workspace:*",
    "@mck/source-openalex": "workspace:*",
    "@mck/source-openlibrary": "workspace:*",
    "@mck/source-usgs": "workspace:*",
    "@mck/source-worldbank": "workspace:*",
