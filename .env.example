MCK_SOURCES=fixture,wikipedia,open-meteo,frankfurter,openalex,openlibrary,hn,usgs,worldbank
# Named bundles: default (free list), trust (full catalog), research, geo, daily
# MCK_SOURCE_PROFILE=research
# MCK_SKU=free
# MCK_SKU=paid
MCK_TRANSPORT=stdio
# false = canonical names (wikipedia.wiki_search). Docker/hosted keep true for existing Cursor configs.
MCK_LEGACY_TOOL_NAMES=false
MCK_LEGACY_ERRORS=false
MCK_CACHE=memory
PORT=8080
LOG_LEVEL=info
# MCK_API_KEYS=key1,key2
# Public unauthenticated MCP at POST /demo/mcp (fixture + wikipedia only).
# MCK_PUBLIC_DEMO=true
# MCK_AUDIT_LOG=true
# MCK_TENANT_ID=tenant-1
# MCK_OAUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# MCK_OAUTH_ISSUER=https://idp.example.com
# MCK_OAUTH_AUDIENCE=mcp-gateway
# MCK_OAUTH_TENANT_CLAIM=sub
# GITHUB_TOKEN=
# BRAVE_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
# MCK_WEB_READER_ALLOWLIST=https://example.com,https://docs.github.com
# REDIS_URL=redis://localhost:6379
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
