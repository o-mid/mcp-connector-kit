{
  "name": "mcp-connector-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm build && pnpm test",
    "validate:registry": "node scripts/validate-registry.mjs",
    "mck": "node packages/cli/dist/cli.js",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/* scripts/strip-ai-git-footers.py",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2",
    "undici": "^7.8.0"
  },
  "packageManager": "pnpm@10.6.5"
}
